{
  /*** P4#2 — DENSE LOCALIZATION-MAP preprocessing profile ***
  // Use when building a map that gicp_localization will register against
  // (NOT needed for odometry-only / quick mapping runs). Select by pointing
  // config.json "config_preprocess" at this file.
  //
  // Rationale (docs in gicp_localization/docs/action_plan_turn_error_20260704.md):
  // the run-12/13 cross-run replays showed a GICP fitness floor of ~0.27
  // (≈0.52 m mean correspondence distance) against maps built with the
  // default 1.0 m random-grid downsample — map sparsity, not misregistration,
  // dominates that floor. Denser preprocessing feeds denser submaps and a
  // denser exported map; gicp_localization keeps its own runtime
  // localization/map_voxel_size as the single runtime density knob.
  //
  // Deltas vs config_preprocess.json:
  //   downsample_resolution    1.0  -> 0.4   (finer random-grid cells)
  //   random_downsample_target 30k  -> 80k   (keep more points per scan)
  // Cost: higher CPU + submap memory during mapping. Re-baseline the GICP
  // fitness floor after rebuilding maps with this profile — all the P1
  // fitness-ratio thresholds assume a re-measured baseline.
  */
  "preprocess": {
    "distance_near_thresh": 0.5,
    "distance_far_thresh": 100.0,
    "use_random_grid_downsampling": true,
    "downsample_resolution": 0.4,
    "random_downsample_target": 80000,
    "random_downsample_rate": 0.1,
    "enable_outlier_removal": false,
    "outlier_removal_k": 10,
    "outlier_std_mul_factor": 1.0,
    "enable_cropbox_filter": false,
    "crop_bbox_frame": "lidar",
    "crop_bbox_min": [-1.0, -1.0, -1.0],
    "crop_bbox_max": [1.0, 1.0, 1.0],
    "k_correspondences": 10,
    "num_threads": 1
  }
}
