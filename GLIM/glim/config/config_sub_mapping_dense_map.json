{
  /*** P4#2 — DENSE LOCALIZATION-MAP submapping profile ***
  // Pair with config_preprocess_dense_map.json when building a map for
  // gicp_localization. Select by pointing config.json "config_sub_mapping"
  // at this file.
  //
  // Deltas vs config_sub_mapping_passthrough.json:
  //   submap_voxel_resolution   0.5  -> 0.25  (finer submap voxels; the map
  //                                            export inherits this density)
  //   min_dist_in_voxel         0.2  -> 0.1   (allow closer points per voxel)
  //   submap_target_num_points  50k  -> 150k  (retain more per submap)
  // Cost: ~3x submap memory / larger exported PCD. gicp_localization's
  // localization/map_voxel_size (0.3 m) remains the runtime density knob —
  // a denser source map lets that runtime voxel actually be FULL instead of
  // sampling an already-sparse cloud. Re-baseline the GICP fitness floor
  // (P1 fitness-ratio thresholds) after rebuilding maps with this profile.
  */
  "sub_mapping": {
    "so_name": "libsub_mapping_passthrough.so",
    "keyframe_update_interval_rot": 0.01,
    "keyframe_update_interval_trans": 0.1,
    "max_num_keyframes": 50,
    "max_num_voxels": -1,
    "adaptive_max_num_voxels": 2.5,
    "submap_voxel_resolution": 0.25,
    "min_dist_in_voxel": 0.1,
    "max_num_points_in_voxel": 100,
    "submap_target_num_points": 150000
  }
}
