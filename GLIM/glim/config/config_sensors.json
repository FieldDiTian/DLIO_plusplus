{
  "lidar_concat": {
    "aux_frames": [
      "luminar_left",
      "luminar_right"
    ],
    "aux_topics": [
      "/luminar_left/points",
      "/luminar_right/points"
    ],
    "buffer_size": 200,
    "enabled": true,
    "primary_frame": "luminar_front",
    "time_threshold": 0.1,
    "urdf_path": "av24.urdf",
    // Strict merge guard. Parity with GICP localization/lidar_concat/require_all_aux.
    // false = OPERATIONAL default: build/localize on whatever LiDARs merged this scan
    // (front + any available aux) instead of aborting when an aux is missing or late,
    // avoiding the scan-gap behavior seen at a tight window. Set true only for a
    // sync-validation pass: an incomplete required merge then SKIPS the scan, and past
    // max_consecutive_merge_failures the node throws/stops only if
    // abort_on_merge_failure=true (otherwise it keeps skipping non-fatally; the
    // startup unresolved-extrinsics check is likewise gated on abort_on_merge_failure).
    // time_threshold raised 0.01 -> 0.1 to match GICP and capture the aux-to-primary jitter.
    "require_all_aux": false,
    // When require_all_aux=true and merges keep failing past the budget:
    //   true  = abort/stop (fail-fast; sync validation / bring-up)
    //   false = keep skipping incomplete scans non-fatally (robust long replays)
    // Ignored when require_all_aux=false. Parity with GICP abort_on_merge_failure.
    "abort_on_merge_failure": true,
    "max_consecutive_merge_failures": 10
  },
  "sensors": {
    "T_lidar_camera": [
      -0.0032,
      -0.05292,
      0.00108,
      0.00837,
      0,
      0,
      1
    ],
    "T_lidar_imu": [
      -0.95065,
      -0.005,
      0.47194,
      0.0,
      0.0,
      0.0,
      1.0
    ],
    // Per-point timestamp auto-detection -- ENABLED.
    //
    // autoconf_perpoint_times=true lets TimeKeeper::replace_points_stamp
    // inspect the first cloud's min/max times and select the right
    // encoding automatically:
    //   * max_time < 1.0           -> scan-relative FLOAT seconds
    //   * max_time > 1.0           -> absolute, auto-convert to relative
    //   * min_time > 1e16          -> raw nanosecond timestamps; applies
    //                                 1e-9 scale
    // For Luminar Iris (UINT8[8] = uint64 PTP epoch ns; see Luminar Iris
    // Data Output Specification v1.3.0 §2.1 packet-header seconds + §2.2/
    // §2.6.3 per-ray nanoseconds, reconstructed to epoch ns by the driver)
    // the times are ALREADY converted to epoch seconds in
    // ros_cloud_converter.hpp (UINT8[8] case divides by 1e9), so by the
    // time TimeKeeper sees them min_time is ~1.7e9, NOT ~1.7e18. It
    // therefore hits the second branch (max_time > 1.0 -> absolute,
    // auto-convert to relative), point_time_scale stays 1.0, and the times
    // are rebased to scan-start; deskew then works correctly. (The
    // min_time > 1e16 branch would only fire for raw, unconverted
    // nanosecond timestamps -- which this pipeline never forwards.)
    //
    // autoconf_prefer_frame_time=false means we USE the per-point times
    // for deskewing instead of collapsing each scan to its frame stamp
    // (which would disable deskewing).
    "autoconf_perpoint_times": true,
    "autoconf_prefer_frame_time": false,
    "distortion_coeffs": [
      -0.02295507941388206,
      0.0681131726659881,
      -0.0005798510962983399,
      0.00128686963241809,
      -0.03279627881588615
    ],
    "distortion_model": "plumb_bob",
    "flip_points_y": false,
    "global_shutter_camera": true,
    // MUST be false for the Luminar Iris (a scanning LiDAR with valid per-point
    // timestamps). When true, the preprocessor ZEROS every per-point time and
    // collapses scan_end_time to the frame stamp, which silently DISABLES motion
    // deskew -- defeating the whole UINT8[8] per-point-time path above. Only set
    // true for a genuine global-shutter sensor with no per-point times.
    "global_shutter_lidar": false,
    "image_size": [
      752,
      480
    ],
    // IMU noise densities feed gtsam::PreintegrationParams. Units:
    //   imu_acc_noise   ~ m/s^2/sqrt(Hz)
    //   imu_gyro_noise  ~ rad/s/sqrt(Hz)
    //   imu_bias_noise  ~ random-walk noise of the constant-bias state
    //   imu_int_noise   ~ integration discretisation noise
    //
    // Tuned for Atlas FusionEngine imu_calibrated on the AV-24 + slow-speed
    // mapping use case. The empirical stationary noise on /gps_p1/imu at 99 Hz
    // is sigma_a ~ 3 mm/s^2 (density ~3e-4 m/s^2/sqrt(Hz)) and sigma_w ~
    // 7e-3 rad/s (density ~7e-4 rad/s/sqrt(Hz)). The upstream GLIM defaults
    // (0.2 / 0.05) were sized for an uncalibrated MEMS at >100x the physical
    // density. We tighten by ~4x for accel and ~5x for gyro -- enough headroom
    // for vibration transients during mapping runs without letting the IMU
    // factor over-power LiDAR. Revert to 0.2 / 0.05 if you ever re-point
    // GLIM at a raw IMU stream (e.g. a NovAtel RAWIMUSX-derived topic).
    "imu_acc_noise": 0.05,
    "imu_gyro_noise": 0.01,
    // Atlas firmware bias is firmware-stable; the GTSAM bias random walk only
    // needs to track slow thermal drift. Tightened from 1e-4 to 1e-5.
    "imu_bias_noise": 1e-5,
    "imu_int_noise": 0.001,
    "intensity_field": "reflectance",
    "intrinsics": [
      815.498895336274,
      817.4904316140473,
      830.3149255906893,
      639.4531613962971
    ],
    // NOTE: perpoint_relative_time and perpoint_time_scale are INERT while
    // autoconf_perpoint_times=true -- TimeKeeper only reads them when autoconf is
    // disabled. Kept as a correct manual fallback (Luminar times are absolute and
    // already epoch-seconds, so relative=false / scale=1.0); changing them has no
    // effect unless autoconf_perpoint_times is set false.
    "perpoint_relative_time": false,
    "perpoint_time_scale": 1.0,
    "ring_field": "line_index",
    "urdf_imu_frame": "gps_antenna_top",
    "urdf_lidar_frame": "luminar_front",
    "urdf_path": "av24.urdf"
  }
}
